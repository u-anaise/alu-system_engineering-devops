#!/usr/bin/env bash
# Installs HAproxy on lb-01 and balances traffic between web-01 and web-02
WEB_01_IP="18.175.239.114"
WEB_02_IP="35.179.138.224"
sudo apt-get update
sudo apt-get install -y haproxy
grep -q '^ENABLED=1' /etc/default/haproxy || echo 'ENABLED=1' | sudo tee -a /etc/default/haproxy > /dev/null
if ! grep -q 'web-backend' /etc/haproxy/haproxy.cfg; then
sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null << EOF

frontend http-in
    bind *:80
    mode http
    default_backend web-backend

backend web-backend
    mode http
    balance roundrobin
    server 7415-web-01 ${WEB_01_IP}:80 check
    server 7415-web-02 ${WEB_02_IP}:80 check
EOF
fi
sudo service haproxy restart
