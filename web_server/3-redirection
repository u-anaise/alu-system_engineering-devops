#!/usr/bin/env bash
# Installs nginx and redirects /redirect_me to another page with a 301
run() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
export DEBIAN_FRONTEND=noninteractive
run apt-get update -y
run apt-get install -y nginx curl
echo "Holberton School for the win!" | run tee /var/www/html/index.html > /dev/null
run tee /etc/nginx/sites-available/default > /dev/null << 'EOF'
server {
    listen 80 default_server;
    root /var/www/html;
    index index.html;
    server_name _;
    location /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }
    location / {
        try_files $uri $uri/ =404;
    }
}
EOF
run nginx -t
run service nginx restart || run nginx
